<Window x:Class="GamePatchDepot.Manager.StableConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正式發布確認"
        Width="600"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="TestConfirmationStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="TestCard" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckBorder" Width="20" Height="20" VerticalAlignment="Top"
                                        Background="White" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="5">
                                    <Path x:Name="CheckMark" Visibility="Collapsed" Data="M 0,4 L 3,7 L 9,0"
                                          Stroke="White" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Border>
                                <ContentPresenter Grid.Column="2" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TestCard" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TestCard" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TestCard" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="18" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.18" Color="#172033" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="24,22,18,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="發布至 Stable" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="將測試版本切換為正式版本" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="30" Height="30" MinHeight="0" Padding="0" Margin="12,0,0,0"
                        VerticalAlignment="Top" FontWeight="Normal" IsCancel="True" ToolTip="取消並關閉" AutomationProperties.Name="取消並關閉" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="24,22,24,22">
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="即將發布的版本" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock x:Name="ReleaseIdText" FontFamily="Cascadia Mono, Consolas" FontSize="23" FontWeight="SemiBold"
                                       Margin="0,5,12,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#DBEAFE" CornerRadius="5" Padding="9,4" VerticalAlignment="Center">
                            <TextBlock Text="STABLE" Foreground="#1D4ED8" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </Grid>
                </Border>
                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="13,11" Margin="0,12,0,20">
                    <TextBlock Text="Stable 玩家下次檢查更新時，將取得此版本。&#x0a;沿用 Test 的檔案，不會重新上傳。"
                               Foreground="#92400E" TextWrapping="Wrap" LineHeight="21" FontSize="13" />
                </Border>
                <TextBlock Text="輸入完整 Release ID 以確認" FontWeight="SemiBold" />
                <TextBox x:Name="ConfirmationTextBox" Margin="0,7,0,8" Padding="11,9" FontFamily="Cascadia Mono, Consolas" FontSize="16"
                         AutomationProperties.Name="輸入完整 Release ID 以確認" TextChanged="ConfirmationTextBox_TextChanged" />
                <TextBlock x:Name="ConfirmationHintText" Text="請輸入上方版本編號，並勾選下方測試確認。"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,16,16" />
                <CheckBox x:Name="GameTestCheckBox" Style="{StaticResource TestConfirmationStyle}"
                          AutomationProperties.Name="已完成 Test 遊戲測試" Checked="ConfirmationChanged" Unchecked="ConfirmationChanged">
                    <StackPanel>
                        <TextBlock Text="我已完成 Test 遊戲測試" FontWeight="SemiBold" />
                        <TextBlock Text="已下載 Test 版本，確認啟動、登入、選角與進入地圖正常。"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0" />
                    </StackPanel>
                </CheckBox>
                <TextBlock Text="R2 深度驗證只確認檔案完整，不能取代實際遊戲測試。"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E7ECF2" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="24,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="先不發布" Width="104" Margin="0,0,10,0" IsCancel="True" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource DangerButtonStyle}" Width="146" Margin="0"
                            IsDefault="True" IsEnabled="False" Click="ConfirmButton_Click" AutomationProperties.Name="確認發布 Stable">
                        <TextBlock Text="確認發布 Stable" Foreground="White" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
