<Window x:Class="GamePatchDepot.Manager.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="540"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Margin="18"
            Padding="0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" Color="#172033" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,18,14,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           FontSize="19"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Width="32"
                        Height="32"
                        MinHeight="0"
                        Margin="10,-7,-1,0"
                        Padding="0"
                        Content="✕"
                        FontSize="13"
                        FontWeight="Normal"
                        ToolTip="關閉"
                        Click="CloseButton_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="22,18,22,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBackground"
                        Width="38"
                        Height="38"
                        CornerRadius="19"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="IconText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold" />
                </Border>
                <ScrollViewer x:Name="MessageScrollViewer" Grid.Column="1" MaxHeight="440" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="MessageText"
                               FontSize="14"
                               LineHeight="23"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    Padding="22,14,15,7"
                    Background="#F8FAFC"
                    BorderBrush="#E7ECF2"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Width="94"
                            Content="取消"
                            IsCancel="True"
                            Click="CancelButton_Click" />
                    <Button x:Name="ConfirmButton"
                            Width="112"
                            Margin="0,0,0,7"
                            Content="知道了"
                            IsDefault="True"
                            Click="ConfirmButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
