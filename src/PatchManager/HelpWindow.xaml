<Window x:Class="GamePatchDepot.Manager.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patch Manager 操作說明"
        Width="760"
        Height="680"
        MinWidth="640"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="怎麼發布遊戲更新" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="照著 1 → 8 操作即可；灰色按鈕表示前一步還沒完成。" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="目前支援範圍">
                    <TextBlock TextWrapping="Wrap" LineHeight="24"
                               Text="新版本支援完整客戶端：EXE、DLL、NX 與子目錄。舊 NX 版本仍可驗證與查閱，畫面會顯示目前版本的範圍。&#x0a;&#x0a;來源必須是可正常執行的完整客戶端。maplelink 的玩家端自動安裝、更新與修復仍待串接。" />
                </GroupBox>
                <GroupBox Header="1. 先填好左邊欄位">
                    <TextBlock TextWrapping="Wrap" LineHeight="24">
                        <Run FontWeight="Bold" Text="Release ID："/><Run Text="這次更新的編號。例如 2026.09.24.1；同一天第二次更新用 2026.09.24.2。&#x0a;"/>
                        <Run FontWeight="Bold" Text="Content Version："/><Run Text="系統會從遠端頻道與本機版本自動計算，不用填，也不能修改。&#x0a;"/>
                        <Run FontWeight="Bold" Text="更新說明："/><Run Text="一句話寫清楚改了什麼。例如「fix(ui): 修正登入畫面」。&#x0a;"/>
                        <Run FontWeight="Bold" Text="完整客戶端目錄："/><Run Text="選擇含遊戲 EXE、DLL、資源及子目錄的根目錄。Prepare 只保存有變更的檔案；第一版才保存全部收錄檔案。&#x0a;"/>
                        <Run FontWeight="Bold" Text="UI 替換檔："/><Run Text="需要用 UI40.nx 等其他檔案取代來源目錄的 UI.nx 時才選。留白時仍會比較並使用來源目錄的 UI.nx。"/>
                    </TextBlock>
                </GroupBox>
                <GroupBox Header="2. 按照 1 → 8 的順序操作">
                    <TextBlock TextWrapping="Wrap" LineHeight="26"
                               Text="1. Prepare：先勾選要收錄的檔案，確認後才建立 Candidate。&#x0a;2. Build：產生更新包。&#x0a;3. 本機驗證：更新只檢查新增或變更檔案；第一版及無基準版本會檢查全部。&#x0a;4. Diff：確認只有預期的檔案被修改。&#x0a;5. Upload：把更新檔上傳到 R2。&#x0a;6. R2 深度驗證：確認雲端檔案完整無誤。&#x0a;7. 發布 Test：先讓測試人員取得更新。&#x0a;8. 遊戲測試正常後，再發布 Stable 給所有玩家。" />
                </GroupBox>
                <GroupBox Header="上傳速度怎麼調？">
                    <TextBlock TextWrapping="Wrap" LineHeight="24"
                               Text="左側「發布流程」標題旁有「同時上傳」選單，可選 1～8。先使用 4；選完自動儲存，下次 Upload 生效，重新開啟也會保留。&#x0a;&#x0a;例如選 4，最多同時處理 4 個物件，不代表快 4 倍。操作途中不能修改；已上傳成功的物件不會因調整數量而重傳。" />
                </GroupBox>
                <GroupBox Header="R2 深度驗證進度">
                    <TextBlock TextWrapping="Wrap" LineHeight="24"
                               Text="先檢查遠端物件，再依實際下載容量顯示百分比、目前檔案與已讀取／總容量。完整檔案及補丁都會驗證。&#x0a;&#x0a;大型分塊下載中也會更新進度，不必等整塊完成。最後核對與寫入驗證紀錄完成前，最多顯示 99.9%；100% 才代表驗證成功。檔名太長時可懸停狀態文字看完整內容。" />
                </GroupBox>
                <GroupBox Header="3. 範例：這次更新 DLL 與 UI.nx">
                    <TextBlock TextWrapping="Wrap" LineHeight="25"
                               Text="把新版 DLL 和 UI.nx 放進完整客戶端，確認遊戲可正常執行。&#x0a;選擇客戶端根目錄，更新說明填「fix(client): 修正介面與客戶端」。其他檔案維持原樣。&#x0a;&#x0a;按 Prepare，清單裡若有不想發布的 settings.ini 就取消勾選。其他遊戲檔案保持勾選，相同內容不會再複製。按「確認並建立 Candidate」後，再 Build、驗證、查看 Diff、上傳並發布 Test。遊戲測試正常才發布 Stable。" />
                </GroupBox>
                <GroupBox Header="哪些檔案會發布？">
                    <TextBlock TextWrapping="Wrap" LineHeight="24"
                               Text="Prepare 先列出檔案讓你確認。日誌、截圖、版本控制資料與常見憑證檔預設排除，不能直接勾回；規則在 config/client-files.json。&#x0a;&#x0a;取消勾選＝不發布、不刪除玩家檔案；舊版曾收錄的檔案會停止追蹤並保留。要刪除舊檔，另外勾「從新版移除」。若只是本次沒有改動，請保持勾選，不需要取消。&#x0a;&#x0a;可搜尋路徑後批次勾選，或按「重設全部」回到建議選擇。按「取消，不建立」就不會建立 Candidate。空檔案可發布；空資料夾不另外記錄。" />
                </GroupBox>
                <GroupBox Header="4. 如果出現錯誤">
                    <TextBlock TextWrapping="Wrap" LineHeight="24" Foreground="#991B1B"
                               Text="先停止操作，查看右側日誌最後一行。不要跳過失敗的步驟，也不要直接發布 Stable。&#x0a;&#x0a;右上角必須顯示「憑證已安全設定」。若 Stable 發布後才發現問題，請建立新的回滾版本，不要覆寫舊版本。" />
                </GroupBox>
                <GroupBox Header="5. 要退回舊版本">
                    <TextBlock TextWrapping="Wrap" LineHeight="24"
                               Text="按右上角「建立退版」→ 選擇舊版本 → 建立。系統會自動產生新的 Release ID 與 Content Version。&#x0a;&#x0a;建立後從「本機驗證」開始，接著 Upload、R2 深度驗證、發布 Test；測試正常後才發布 Stable。" />
                </GroupBox>
                <GroupBox Header="6. 取消或回退">
                    <TextBlock TextWrapping="Wrap" LineHeight="24"
                               Text="操作正在執行：按「取消目前操作」，系統會先安全通知發布工具停止並清除暫存。&#x0a;Prepare 完成但尚未 Build：按「回退上一步」，可捨棄 Candidate 後重新 Prepare。&#x0a;Build 完成但尚未發布：不可覆寫同一版本；按「完全取消版本」，再使用新的 Release ID。&#x0a;已發布 Test／Stable：不能降低頻道版本，系統會引導建立退版。" />
                </GroupBox>
                <GroupBox Header="7. 關閉後繼續">
                    <TextBlock TextWrapping="Wrap" LineHeight="24"
                               Text="可以直接關閉 UI。下次開啟時，系統會回到最新的未完成版本，原本的版本號、來源資料夾與更新說明都會保留，不會重新 Prepare 或複製檔案。" />
                </GroupBox>
                <GroupBox Header="8. 重設並建立下一版">
                    <TextBlock TextWrapping="Wrap" LineHeight="24"
                               Text="按右上角「重設／下一版」，確認後會產生新的 Release ID 與 Content Version，清空更新說明及選用替換檔，進度回到 0。來源資料夾與同時上傳數會保留。&#x0a;&#x0a;這是重設畫面，不是刪除資料：舊 Candidate、Manifest、發布紀錄及 R2 檔案全部保留，未完成版本也不會被取消。需要取消舊版時，請使用「完全取消版本」。&#x0a;&#x0a;發布 Stable 後會顯示「正式發布完成」，不會自動清空；按重設才開始下一版。已發布版本不能直接回退或取消，請使用「建立退版」。" />
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" Style="{StaticResource PrimaryButtonStyle}" Content="關閉" HorizontalAlignment="Right" Width="100" Margin="0,14,0,0" IsCancel="True" />
    </Grid>
</Window>
